{
  "pinned": [
    "com.taboost.rng-ingest",
    "com.taboost.recruit-nightly"
  ],
  "managed": [
    {
      "id": "live-agent",
      "name": "live-agent",
      "cwd": "~/live-agent",
      "start": [
        "sh",
        "scripts/start.sh"
      ],
      "stop": [
        "node",
        "src/daemon.ts",
        "stop"
      ],
      "match": "src/daemon.ts"
    },
    {
      "id": "rnr-messenger",
      "name": "RnR Messenger",
      "cwd": "~",
      "start": [
        "open",
        "-a",
        "RnR Backstage IM Messenger"
      ],
      "stop": [
        "osascript",
        "-e",
        "quit app \"RnR Backstage IM Messenger\""
      ],
      "match": "RnR Backstage IM Messenger.app/Contents/MacOS"
    }
  ]
}
